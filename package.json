{
  "name": "game-bridge-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "release:build": "npm run build && npm run release:manifest",
    "release:manifest": "node scripts/create-release-manifest.mjs dist",
    "release:check": "node scripts/create-release-manifest.mjs dist --check"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.57.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
